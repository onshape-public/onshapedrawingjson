{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://drawing-schemas.onshape.com/annotations/dimensions/linetolineangulardimension",
    "title": " Line To Line Angular Dimension Annotation",
    "description": "Defines angle between two lines",
    "type": "object",
    "properties": {
      "logicalId": {
        "$ref": "../commonproperties.schema.json#/properties/logicalId"
      },
      "point1": {
        "description":"First definition point for the dimension",
        "$ref": "../types/point.schema.json"
      },
      "point2": {
        "description":"Second definition point for the dimension",
        "$ref": "../types/point.schema.json"
      },
      "point3": {
        "description":"Third definition point for the dimension",
        "$ref": "../types/point.schema.json"
      },
      "point4": {
        "description":"Fourth definition point for the dimension",
        "$ref": "../types/point.schema.json"
      },
      "arcPoint": {
        "description":"Arc definition point for the dimension",
        "$ref": "../types/point.schema.json"
      },
      "textPosition": {
        "$ref": "../commonproperties.schema.json#/properties/textPosition"
      },
      "textOverride": {
        "$ref": "../commonproperties.schema.json#/properties/textOverride"
      },
      "formatting": {
        "$ref": "../commonproperties.schema.json#/properties/formatting"
      },
      "measurement": {
        "$ref": "../commonproperties.schema.json#/properties/measurement"
      },
      "displayedValue": {
        "$ref": "../commonproperties.schema.json#/properties/displayedValue"
      },
      "isDangling": {
        "$ref": "../commonproperties.schema.json#/properties/isDangling"
      },
      "isDrivingDimension": {
        "$ref": "../commonproperties.schema.json#/properties/isDrivingDimension"
      },
	  "precision": {
        "$ref": "../commonproperties.schema.json#/properties/precision"
	  },
      "isPrecisionOverridden": {
        "$ref": "../commonproperties.schema.json#/properties/isPrecisionOverridden"
      },
      "unit": {
        "$ref": "../commonproperties.schema.json#/properties/unit"
      },
      "boundingBoxPoints": {
        "$ref": "../commonproperties.schema.json#/properties/boundingBoxPoints"
      },
	  "tolerance": {
        "$ref": "../commonproperties.schema.json#/properties/tolerance"
	  },
	  "aliasLogicalId": {
        "$ref": "../commonproperties.schema.json#/properties/aliasLogicalId"
	  },
      "textAbove": {
        "$ref": "../commonproperties.schema.json#/properties/textAbove"
      },
      "textBelow": {
        "$ref": "../commonproperties.schema.json#/properties/textBelow"
      },
      "prefix": {
        "$ref": "../commonproperties.schema.json#/properties/prefix"
      },
      "suffix": {
        "$ref": "../commonproperties.schema.json#/properties/suffix"
      },
      "displayParentheses": {
        "$ref": "../commonproperties.schema.json#/properties/displayParentheses"
      },
      "inspection": {
        "$ref": "../commonproperties.schema.json#/properties/inspection"
      },
      "showFirstExtensionLine": {
        "$ref": "../commonproperties.schema.json#/properties/showFirstExtensionLine"
      },
      "showSecondExtensionLine": {
        "$ref": "../commonproperties.schema.json#/properties/showSecondExtensionLine"
      },
      "breakDimensionLine": {
        "$ref": "../commonproperties.schema.json#/properties/breakDimensionLine"
      }
    },
    "additionalProperties": false,
    "required": ["point1", "point2", "point3", "point4", "arcPoint", "textPosition", "unit"]
  }
  