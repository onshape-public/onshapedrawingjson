{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://drawing-schemas.onshape.com/annotations/holecallout",
	"title": "HoleCallout Annotation",
	"description": "Defines a hole callout for hole(Circular edge)",
	"type": "object",
	"properties": {
		"logicalId": {
		    "$ref": "commonproperties.schema.json#/properties/logicalId"
		},
		"textPosition": {
		    "$ref": "commonproperties.schema.json#/properties/textPosition"
		},
		"leaderPosition": {
		    "$ref": "commonproperties.schema.json#/properties/leaderPosition"
		},
		"leaderLogicalId": {
			"description": "Logical ID of the leader",
			"type": "string"
		},
		"displayedValue": {
		    "$ref": "commonproperties.schema.json#/properties/displayedValue"
		},
		"textAbove": {
		    "$ref": "commonproperties.schema.json#/properties/textAbove"
		},
		"textBelow": {
		    "$ref": "commonproperties.schema.json#/properties/textBelow"
		},
		"prefix": {
		    "$ref": "commonproperties.schema.json#/properties/prefix"
		},
		"suffix": {
		    "$ref": "commonproperties.schema.json#/properties/suffix"
		},
		"isDangling": {
		    "$ref": "commonproperties.schema.json#/properties/isDangling"
		},
		"boundingBoxPoints": {
		    "$ref": "commonproperties.schema.json#/properties/boundingBoxPoints"
		},
		"aliasLogicalId": {
		    "$ref": "commonproperties.schema.json#/properties/aliasLogicalId"
		},
		"holeCount": {
			"description": "The hole count",
			"type": "number"
		},
		"holeCountOverride": {
			"description": "The overridden hole count",
			"type": "string"
		},
		"holeCountType": {
			"type": "string",
			"enum": [
				"None",
				"View",
				"Pattern",
				"Part",
				"Face",
				"Face_Excluding_Pattern"
			]
		},
		"isPrecisionToleranceOverridden": {
			"description": "True if the precision and tolerance is overridden",
			"type": "boolean"
		},
		"isInspection": {
			"description": "If Hole callout is display with inspection type then it will be true else false",
			"type": "boolean"
		},
		"holeDiameter": {
			"description": "Hole diameter",
			"$ref": "types/holeValue.schema.json"
		},
		"holeDepth": {
			"description": "Hole depth",
			"$ref": "types/holeValue.schema.json"
		},
		"cBoreDiameter": {
			"description": "Counter bore diameter",
			"$ref": "types/holeValue.schema.json"
		},
		"cBoreDepth": {
			"description": "Couter bore depth",
			"$ref": "types/holeValue.schema.json"
		},
		"cSinkAngle": {
			"description": "Couter sink angle",
			"$ref": "types/holeValue.schema.json"
		},
		"cSinkDiameter": {
			"description": "Couter sink diameter",
			"$ref": "types/holeValue.schema.json"
		},
		"tappedDepth": {
			"description": "Tapped depth",
			"$ref": "types/holeValue.schema.json"
		},
		"threadSpecification": {
			"description": "Thread specification of a tapped hole as shown in the hole callout, Read-only",
			"type": "string"
		},
		"unit": {
		    "$ref": "commonproperties.schema.json#/properties/unit"
		},
		"isUnitOverridden": {
			"description": "True if the hole callout unit is overridden.",
			"type": "boolean"
		},
		"landingLength": {
			"description": "Leader landing line length or jog segment length for the hole callout leader",
			"type": "number",
			"minimum": 0
		}
	},
	"additionalProperties": false,
	"required": [
		"textPosition",
		"leaderPosition",
		"unit"
	]
}