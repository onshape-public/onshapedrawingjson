{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://drawing-schemas.onshape.com/annotations/note",
    "title": "Note",
    "description": "Defines a Note with an optional leader.",
    "type": "object",
    "properties": {
        "logicalId": {
            "$ref": "commonproperties.schema.json#/properties/logicalId"
        },
        "position": {
            "description":"Text position, non-associative",
            "$ref": "types/point.schema.json"
        },
        "leaderPosition": {
            "$ref": "commonproperties.schema.json#/properties/leaderPosition"
        },
        "contents": {
            "description":"The text contents. May include MText formatting codes.",
            "type": "string"
        },
        "textHeight": {
            "$ref": "commonproperties.schema.json#/properties/textHeight"
        },
        "isDangling": {
            "$ref": "commonproperties.schema.json#/properties/isDangling"
        },
        "boundingBoxPoints": {
            "$ref": "commonproperties.schema.json#/properties/boundingBoxPoints"
        },
        "aliasLogicalId": {
            "$ref": "commonproperties.schema.json#/properties/aliasLogicalId"
        }
    },
    "additionalProperties": false,
    "required": ["position","contents"]
}
