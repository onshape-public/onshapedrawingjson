{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://drawing-schemas.onshape.com/annotations/tables/generaltable",
    "title": "General Table Annotation",
    "description": "Defines a table with fixed Rows and Coloumns. Rows and Coloumn number can we defined at creation alsong with some general properties",
    "type": "object",
    "properties": {
        "logicalId": {
            "$ref": "../commonproperties.schema.json#/properties/logicalId"
        },
        "position": {
            "description":"Table position, non-associative",
            "$ref": "../types/point.schema.json"
        },
        "rows": {
            "description": "Number of rows in the table (must be greater than zero)",
            "$ref": "../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
        },
        "columns": {
            "description": "Number of columns in the table (must be greater than zero)",
            "$ref": "../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
        },
        "formatting": {
            "description": "Table formatting override for this table",
            "$ref": "../formatting/tableformatting.schema.json"
        },
        "showTitleRow": {
            "description": "Flag to determine visible state of title row",
            "type": "boolean",
            "default": false
        },
        "showHeaderRow": {
            "description": "Flag to determine visible state of header row",
            "type": "boolean",
            "default": false
        },
        "horizontalCellMargin": {
            "description": "Horizontal margin around cell text",
            "$ref": "../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
        },
        "verticalCellMargin": {
            "description": "Vertical margin around cell text",
            "$ref": "../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
        },
        "cells": {
            "description": "Cells in the table",
            "type": "array",
            "items": {
              "title": "Cell",
              "$ref": "./types/cell.schema.json"
            }
        },
        "boundingBoxPoints": {
            "$ref": "../commonproperties.schema.json#/properties/boundingBoxPoints"
        },
        "aliasLogicalId": {
            "$ref": "../commonproperties.schema.json#/properties/aliasLogicalId"
        },
        "cellOverrides": {
            "description": "Optional list of individual cell overrides.",
            "type": "array",
            "items": {
                "description": "Cell override with explicit location, for use in cellOverrides where position is not otherwise implied.",
                "$ref": "./types/cell.schema.json"
            }
        },
        "splitRows": {
            "description": "Array of row numbers after which the table will be split.",
            "type": "array",
            "items": {
                "type": "integer",
                "minimum": 1
            }
        }
    },
    "required": ["rows","columns","position"]
}
