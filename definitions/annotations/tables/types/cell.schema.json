{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://drawing-schemas.onshape.com/annotations/table/types/cell",
    "title": "Cell",
    "type": "object",
    "properties": {
      "row" : {
        "description": "Cell row index",
        "$ref": "../../../propertiesUtilDefs.schema.json#definition/nonNegativeInteger"
      },
      "column" : {
        "description": "Cell column index",
        "$ref": "../../../propertiesUtilDefs.schema.json#definition/nonNegativeInteger"
      },
      "propertyId": {
        "description": "Property identifier used by table to map cell content",
        "type": "string"
      },
      "content": {
        "description": "Cell content",
        "type": "string"
      },
      "isContentOverridden": {
        "description": "Whether the cell content is overridden",
        "type": "boolean",
        "default": false
      },
      "alignment": {
        "description": "Cell alignment",
        "$ref": "../../types/alignment.schema.json"
      },
      "font": {
        "description": "Cell font",
        "$ref": "../../types/font.schema.json"
      },
      "isStrikeThrough": {
        "description": "Flag to identify if cell content is strikedthrough.",
        "type": "boolean",
        "default": false
      },
      "isUnderlined": {
        "description": "Flag to identify if cell content is underlined.",
        "type": "boolean",
        "default": false
      },
      "isBold": {
        "description": "Flag to identify if cell content is bold",
        "type": "boolean",
        "default": false
      },
      "isItalic": {
        "description": "Flag to identify if cell content is italic",
        "type": "boolean",
        "default": false
      },
      "contentColor": {
        "description": "Content color of cell",
        "$ref":"../../types/color.schema.json"
      },
      "isMerged": {
        "description": "Flag to identify the merge cell",
        "type": "boolean",
        "default": false
      },
      "minRow": {
        "description": "Minimum row index of the merged cell",
        "$ref": "../../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
      },
      "maxRow": {
        "description": "Maximum row index of the merged cell",
        "$ref": "../../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
      },
      "minCol": {
        "description": "Minimum column index of the merged cell",
        "$ref": "../../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
      },
      "maxCol": {
        "description": "Maximum column index of the merged cell",
        "$ref": "../../../propertiesUtilDefs.schema.json#definition/nonNegativeIntegerDefault0"
      },
      "textHeight": {
        "description":"Default height of the text. Overrides the text height from the style.",
        "$ref": "../../../propertiesUtilDefs.schema.json#definition/nonNegativeDecimalDefault0"
      }
    },
    "required": ["row", "column"]
}